# 服务端口
PORT=3456

# 工作台名称
WORKBENCH_NAME=数字人智能体工作台

# 中转平台 (模块一文案提取 & 模块四数字人对口型)
HZAGENT_BASE_URL=https://ai.hzagent.cn
HZAGENT_API_KEY=
HZAGENT_EXTRACT_PATH=/api/v1/video/extract-copy
HZAGENT_LIPSYNC_PATH=/api/v1/avatar/lipsync
HZAGENT_TASK_PATH=/api/v1/tasks

# 模块二：DeepSeek 大模型文案二创
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 模块三：MiniMax 声音复刻与语音合成
MINIMAX_BASE_URL=https://api.minimax.cn
MINIMAX_API_KEY=
MINIMAX_DEFAULT_VOICE_ID=
MINIMAX_TTS_MODEL=speech-2.8-hd

# 模块五：开拍 CLI (可选，如已在终端运行 kaipai auth login 可留空)
KAIPAI_ACCESS_KEY=
KAIPAI_BIN=kaipai
